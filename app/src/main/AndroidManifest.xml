<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Smart_Group">

        <activity
            android:name=".SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.Smart_Group" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Smart_Group">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.courses.CoursesActivity"
            android:exported="false"
            android:theme="@style/Theme.Smart_Group" />

        <activity
            android:name=".ui.courses.AdminActivity"
            android:exported="false"
            android:theme="@style/Theme.Smart_Group" />

        <activity
            android:name=".ui.courses.LocationActivity"
            android:exported="false"
            android:theme="@style/Theme.Smart_Group" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.forgotpassword.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:label="@string/title_activity_register"
            android:theme="@style/Theme.Smart_Group" />

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Smart_Group" />
        <activity
            android:name=".ui.courses.StatsActivity"
            android:exported="false"
            android:theme="@style/Theme.Smart_Group" />

    </application>

</manifest>