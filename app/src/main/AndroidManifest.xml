<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.smart_group">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Smart_Group">

        <!-- CoursesActivity נפתח ראשון -->
        <activity
            android:name=".ui.courses.CoursesActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- LoginActivity -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false" />

        <!-- Register -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Forgot Password -->
        <activity
            android:name=".ui.forgotpassword.ForgotPasswordActivity"
            android:exported="false" />

        <!-- Profile -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />

        <!-- Admin -->
        <activity
            android:name=".ui.courses.AdminActivity"
            android:exported="false" />

    </application>

</manifest>