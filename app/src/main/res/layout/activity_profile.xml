<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background">


    <ImageView
        android:id="@+id/img_logo"
        android:layout_width="160dp"
        android:layout_height="120dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="4dp"
        android:adjustViewBounds="true"
        android:contentDescription="App Logo"
        android:scaleType="fitCenter"
        android:src="@drawable/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/img_avatar"
        android:layout_width="200dp"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:contentDescription="User Avatar"
        android:src="@drawable/account_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_logo" />

    <!-- User Name (from Firebase) -->
    <TextView
        android:id="@+id/tv_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="User Name"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/img_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Anat Stefanski"/>

    <!-- Email (from FirebaseAuth) -->
    <TextView
        android:id="@+id/tv_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="email@email.com"
        android:textColor="#6B6B6B"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_user_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="anat@email.com"/>

    <!-- Button: Edit Profile -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_edit_profile"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:layout_marginTop="50dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:text="Edit Profile"
        android:textAllCaps="false"
        android:textSize="20sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/gray"
        android:backgroundTint="@color/lightWhite"
        android:elevation="1dp"
        android:textColor="@color/black"
        app:icon="@drawable/edit"
        app:iconGravity="textEnd"
        app:iconTint="@color/black"
        app:iconPadding="15dp"
        app:layout_constraintTop_toBottomOf="@id/tv_email"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Button: View Questionnaire -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_view_questionnaire"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:layout_marginTop="14dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:text="Edit Questionnaire"
        android:textAllCaps="false"
        android:textSize="20sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        android:textColor="@color/black"
        android:elevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/gray"
        android:backgroundTint="@color/lightWhite"
        app:icon="@drawable/list"
        app:iconGravity="textEnd"
        app:iconTint="@color/black"
        app:iconPadding="15dp"
        app:layout_constraintTop_toBottomOf="@id/btn_edit_profile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_menu"
        app:labelVisibilityMode="unlabeled"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        app:itemIconSize="28dp"
        app:itemBackground="@drawable/bottom_nav_background"
        android:background="@color/lightBlue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
