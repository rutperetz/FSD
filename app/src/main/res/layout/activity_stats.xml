<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStatsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Course Statistics"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvTotalCourses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Courses: 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvMathCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="מתמטיקה: 0"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressMath"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="0"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvCodeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="שפות תכנות: 0"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressCode"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="0"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvCsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="מדעי המחשב: 0"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressCs"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="0"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>